<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.halbmann</groupId>
        <artifactId>sam</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>de.halbmann.sam</groupId>
    <artifactId>ui</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>2.7.2</version>
        </dependency>

        <!-- API dependencies - for ts-model generation -->
        <dependency>
            <groupId>de.halbmann.sam</groupId>
            <artifactId>api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus.resteasy.reactive</groupId>
            <artifactId>resteasy-reactive-common</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>dependency-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <configuration>
                            <!-- Erlaubt dem Plugin, Dateien außerhalb des Standard-Java-Scopes zu finden -->
                            <scanSet>
                                <fileSet>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>package.json</include>
                                        <include>package-lock.json</include>
                                    </includes>
                                </fileSet>
                            </scanSet>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>generate-ts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>cz.habarta.typescript-generator</groupId>
                        <artifactId>typescript-generator-maven-plugin</artifactId>
                        <version>3.2.1263</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <jsonLibrary>jsonb</jsonLibrary>
                            <classPatterns>
                                <classPattern>de.halbmann.sam.api.entity.*</classPattern>
                            </classPatterns>
                            <customTypeMappings>
                                <customTypeMapping>java.time.Duration:long</customTypeMapping>
                                <customTypeMapping>de.halbmann.sam.api.entity.DifficultyLevel:short</customTypeMapping>
                            </customTypeMappings>
                            <outputFile>src/main/webui/src/app/model/datamodels.d.ts</outputFile>
                            <outputKind>module</outputKind>
                            <requiredAnnotations>
                                jakarta.validation.constraints.NotBlank,jakarta.validation.constraints.NotEmpty,jakarta.validation.constraints.NotNull
                            </requiredAnnotations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>