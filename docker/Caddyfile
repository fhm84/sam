# Edge proxy, baked into the sam-ui image: serves the Angular SPA, proxies the API to
# sam-server and the login hostname to the OIDC provider, and terminates TLS.
# Certificates are obtained and renewed automatically (Let's Encrypt) once the DNS
# records resolve to this host and ports 80/443 are reachable.
{
	email {$ACME_EMAIL}
}

{$SAM_DOMAIN} {
	encode zstd gzip

	# Ops endpoints (ADR-0010): reachable on the internal network only.
	# Prometheus scrapes sam-server:9000 directly.
	handle /q/* {
		respond "Not Found" 404
	}

	handle /api/* {
		reverse_proxy sam-server:8080
	}

	# The JAX-RS application root is /api, so the endpoint lives at /api/oidc-config.json;
	# the Angular app requests it at the root path.
	handle /oidc-config.json {
		rewrite * /api/oidc-config.json
		reverse_proxy sam-server:8080
	}

	# Angular SPA — fall back to index.html for client-side routing
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Login host: the active OIDC provider. Pocket ID and Keycloak both answer as oidc:8080 on the
# internal network (docker-compose.prod.yml), so this needs no provider setting.
{$LOGIN_DOMAIN} {
	# Keycloak's admin console and admin REST API stay off the internet: use them through an
	# SSH tunnel to the server. Pocket ID has no /admin path (its admin pages are /settings/admin).
	@admin path /admin /admin/*
	handle @admin {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy oidc:8080
	}
}
