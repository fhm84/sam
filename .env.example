# Copy this file to .env and fill in the values before running docker-compose.prod.yml
# .env is gitignored — never commit secrets.

# ── Images ────────────────────────────────────────────────────────────────────
# Tag of ghcr.io/fhm84/sam and ghcr.io/fhm84/sam-ui (published by CI for amd64 and arm64).
# Default: latest. Pin a sha-<short> tag or a version for reproducible deploys and rollbacks.
#SAM_IMAGE_TAG=latest

# ── Public hostnames / TLS ────────────────────────────────────────────────────
# Both need DNS A records pointing at this server before first start.
SAM_DOMAIN=sam.example.org
# Login host of the OIDC provider (Pocket ID or Keycloak)
LOGIN_DOMAIN=login.example.org
# Contact address for Let's Encrypt (expiry notices)
ACME_EMAIL=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=sam
DB_PASS=changeme

# ── OIDC provider ─────────────────────────────────────────────────────────────
# pocket-id (default) or keycloak. Fill in only that provider's section below.
SAM_OIDC_PROVIDER=pocket-id
# Starts the provider's containers (the compose profile has the provider's name). Keep as is.
COMPOSE_PROFILES=${SAM_OIDC_PROVIDER}
OIDC_CLIENT_ID=sam-ui

# ── Pocket ID (SAM_OIDC_PROVIDER=pocket-id) ───────────────────────────────────
# Encrypts Pocket ID's stored keys; required, never change it after the first start
# (generate with: openssl rand -base64 32)
POCKET_ID_ENCRYPTION_KEY=changeme
# Optional: API key for the user search when linking musicians to logins (Pocket ID:
# Settings → Administration → API Keys). It has full admin rights on Pocket ID; without it,
# admins link a musician by entering the user's ID. Rotation: docs/architecture/concepts/security.md
#SAM_OIDC_POCKET_ID_API_KEY=

# Name shown on the login pages and in Pocket ID's mails. Default: SAM
#POCKET_ID_APP_NAME=SAM

# ── Mail (Pocket ID login codes) ──────────────────────────────────────────────
# Optional: lets admins email login codes instead of handing out links. A dedicated mailbox,
# not a personal one: whoever has this password can send mail as that address.
#SMTP_HOST=mail.example.org
#SMTP_PORT=587
# starttls (port 587), tls (port 465) or none
#SMTP_TLS=starttls
#SMTP_FROM=sam@example.org
#SMTP_USER=sam@example.org
#SMTP_PASSWORD=changeme
# Turn on once Pocket ID's test mail arrives (Settings → Application Configuration → Email →
# Send test email): Pocket ID reports a login code as sent even when SMTP doesn't work.
#POCKET_ID_EMAIL_LOGIN_CODES=true

# ── Keycloak (SAM_OIDC_PROVIDER=keycloak) ─────────────────────────────────────
# Issuer: the realm URL on the login host (Pocket ID's issuer is the login host itself)
#OIDC_SERVER_URL=https://login.example.org/realms/sam
# Service-account secrets; written into the realm on first import (generate with: openssl rand -hex 24)
#KEYCLOAK_BACKEND_CLIENT_SECRET=changeme
#KEYCLOAK_CLI_CLIENT_SECRET=changeme
# Master-realm admin (bootstrap account) and Keycloak's own database
#KEYCLOAK_ADMIN_USER=admin
#KEYCLOAK_ADMIN_PASSWORD=changeme
#KEYCLOAK_DB_PASS=changeme
# Defaults that rarely need changing
#KEYCLOAK_ADMIN_URL=http://keycloak:8080
#KEYCLOAK_REALM=sam
#KEYCLOAK_BACKEND_CLIENT_ID=sam-backend

# ── AI ────────────────────────────────────────────────────────────────────────
# OpenAI API key for document classification (gpt-4o)
OPENAI_API_KEY=sk-...
# Optional: agentic classification — a second LLM pass that resolves composer/sheet/instrument
# via tool calls (more tokens, sometimes better matches). Default: false.
#SAM_CLASSIFICATION_AGENTIC=true

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Prometheus + Grafana + host metrics: add `monitoring` to the profiles, e.g.
#   COMPOSE_PROFILES=${SAM_OIDC_PROVIDER},monitoring
# Grafana listens on the server's loopback only (ssh -L 3000:localhost:3000 <server>).
# Its admin password is required with the profile and applies on Grafana's first start only.
#GRAFANA_ADMIN_PASSWORD=changeme

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container where sheet music files are stored.
# Overriding this changes the Docker volume mount target — update docker-compose.prod.yml accordingly.
# SAM_FILESYSTEM_BASE_PATH=/data/sam
