[Unit]
Description=SAM health check
# Ordered after Docker but without pulling it in: the check reports a stopped Docker and must not
# start it again (it doesn't call docker then either, which would start it through its socket)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Assumes the repo is checked out at /opt/sam
ExecStart=/usr/bin/bash /opt/sam/scripts/alerts/check.sh
# "-": a failed report must not fail the run
ExecStopPost=-/usr/bin/bash /opt/sam/scripts/alerts/report.sh SAM_ALERT_CHECK_URL
# The check's own time limits add up to about 2 minutes
TimeoutStartSec=4min
