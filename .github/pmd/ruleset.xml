<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="SAM"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>PMD's quickstart ruleset, minus rules that don't fit this code base.</description>

    <rule ref="rulesets/java/quickstart.xml">
        <!-- SLF4J's parameterised logging ({} placeholders) already defers message formatting,
             so wrapping every call in isXxxEnabled() only adds noise. -->
        <exclude name="GuardLogStatement"/>
    </rule>
</ruleset>
